{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alaska Air Cargo Airports Transactions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Alaska Airlines Get Mileage Plan Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.alaskacargo.com/v1/members/:memberId/transactions",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "Mileage Plan member number"
              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query",
                "description": "Start date filter (YYYY-MM-DD)"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query",
                "description": "End date filter (YYYY-MM-DD)"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Transaction type filter"
              }
            ]
          },
          "docs": "Retrieve mile earning and redemption transaction history for a Mileage Plan member."
        }
      ]
    }
  ],
  "bundled": true
}