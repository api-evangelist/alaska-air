            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"<string>\",\n  \"destination\": \"<string>\",\n  \"shipDate\": \"<date>\",\n  \"weight\": \"<number>\",\n  \"pieces\": \"<integer>\",\n  \"commodity\": \"<string>\",\n  \"weightUnit\": \"<string>\",\n  \"dimensions\": {\n    \"length\": \"<number>\",\n    \"width\": \"<number>\",\n    \"height\": \"<number>\",\n    \"unit\": \"<string>\"\n  },\n  \"specialHandling\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
