{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alaska Air Cargo Airports API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Airports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Alaska Airlines List Airports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.alaskacargo.com/v1/airports",
            "params": [
              {
                "name": "country",
                "value": "",
                "type": "query",
                "description": "Filter airports by ISO country code"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter airports by US state code"
              }
            ]
          },
          "docs": "Retrieve a list of airports served by Alaska Airlines and Horizon Air with IATA codes, names, cities, and geographic coordinates."
        }
      ]
    }
  ],
  "bundled": true
}