{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alaska Air Cargo Airports Members API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Alaska Airlines Get Mileage Plan Member",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.alaskacargo.com/v1/members/:memberId",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "Alaska Airlines Mileage Plan member number"
              }
            ]
          },
          "docs": "Retrieve Mileage Plan member information including tier status, balance, and account details for a specific member ID."
        }
      ]
    }
  ],
  "bundled": true
}