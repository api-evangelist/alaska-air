{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/alaska-air/refs/heads/main/json-structure/alaska-air-mileage-plan-partner-miles-response-structure.json",
  "name": "PartnerMilesResponse",
  "type": "object",
  "description": "Response confirming partner miles credit",
  "properties": {
    "transactionId": {
      "type": "string",
      "description": "Unique transaction identifier",
      "example": "TXN-111222"
    },
    "memberId": {
      "type": "string",
      "description": "Member number",
      "example": "12345678"
    },
    "miles": {
      "type": "int32",
      "description": "Miles credited",
      "example": 500
    },
    "newBalance": {
      "type": "int32",
      "description": "Updated mile balance",
      "example": 125500
    },
    "status": {
      "type": "string",
      "description": "Transaction status",
      "enum": [
        "credited",
        "pending",
        "rejected"
      ],
      "example": "credited"
    }
  }
}