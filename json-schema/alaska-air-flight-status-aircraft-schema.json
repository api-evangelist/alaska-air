{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/alaska-air/refs/heads/main/json-schema/alaska-air-flight-status-aircraft-schema.json",
  "title": "Aircraft",
  "description": "Aircraft information for the flight",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Aircraft type/model",
      "example": "Boeing 737-900ER"
    },
    "tailNumber": {
      "type": "string",
      "description": "Aircraft tail number (registration)",
      "example": "N491AS"
    }
  }
}